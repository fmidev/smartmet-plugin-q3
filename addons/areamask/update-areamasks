#!/usr/bin/make -f
#
# Makefile for re-creation of areamask files, based on SVG files

#--
# SVG files available (21-Jun-10):
#
# ahvenanmaa.svg       etela-savo.svg       keski-suomi.svg  paijat-hame.svg      pohjois-lappi.svg      satakunta.svg  
# hame.svg             koillismaa.svg       pirkanmaa.svg    pohjois-pohjanmaa.svg varsinais-suomi.svg
# etela-karjala.svg    kainuu.svg           kymenlaakso.svg  pohjanmaa.svg        pohjois-savo.svg       suomi.svg
# etela-pohjanmaa.svg  keski-pohjanmaa.svg  lansi-lappi.svg  pohjois-karjala.svg  rannikko.svg           uusimaa.svg
#
SVG_PATH=/smartmet/share/textgendata/maps/sonera

NAMES=$(notdir $(basename $(wildcard $(SVG_PATH)/*.svg)))

LUAS=$(addsuffix .lua, $(NAMES))

all: $(LUAS)

%.lua: $(SVG_PATH)/%.svg tools/rajat.lua
	LUA_PATH="tools/?.lua;../../tools/?.lua" \
	  lua -lstrict tools/rajat.lua $< > $@

echo:
	@echo $(LUAS)

